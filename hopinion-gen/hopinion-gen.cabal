library
  exposed-modules:
      Hopinion.Facts.Gen
      Hopinion.Rule.Gen
  other-modules:
      Paths_hopinion_gen
  hs-source-dirs:
      src
  ghc-options: -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Widentities -Wredundant-constraints -Wcpp-undef -Wunused-packages
  build-depends:
      QuickCheck
    , base >=4.7 && <5
    , genvalidity
    , genvalidity-aeson
    , genvalidity-containers
    , genvalidity-path
    , genvalidity-text
    , hopinion
    , text
  default-language: Haskell2010

executable hopinion-example
  main-is: Main.hs
  other-modules:
      Paths_hopinion_gen
  hs-source-dirs:
      app
  ghc-options: -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Widentities -Wredundant-constraints -Wcpp-undef -Wunused-packages -threaded -rtsopts -with-rtsopts=-N8
  build-depends:
      base >=4.7 && <5
    , hopinion
    , hopinion-gen
  default-language: Haskell2010

test-suite hopinion-test
  type: exitcode-stdio-1.0
