cabal-version: 1.12
name: jobs
version: 0.0.0
build-type: Simple

library
  exposed-modules:
      Jobs.Payload
  hs-source-dirs:
      src
  build-depends:
      base
  default-language: Haskell2010

test-suite jobs-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs:
      test
  build-depends:
      base
    , thing
  default-language: Haskell2010
