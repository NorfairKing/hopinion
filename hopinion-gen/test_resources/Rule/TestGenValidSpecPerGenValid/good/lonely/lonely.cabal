cabal-version: 1.12
name: lonely
version: 0.0.0
build-type: Simple

library
  exposed-modules:
      Lonely
  hs-source-dirs:
      src
  build-depends:
      base
  default-language: Haskell2010

test-suite lonely-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      LonelyChecks
  hs-source-dirs:
      test
  build-depends:
      base
  default-language: Haskell2010
