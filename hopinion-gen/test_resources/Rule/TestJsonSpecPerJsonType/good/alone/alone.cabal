cabal-version: 1.12
name: alone
version: 0.0.0
build-type: Simple

library
  exposed-modules:
      Alone
  hs-source-dirs:
      src
  build-depends:
      base
  default-language: Haskell2010

test-suite alone-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      AloneChecks
  hs-source-dirs:
      test
  build-depends:
      base
  default-language: Haskell2010
